#!/bin/sh
# Adapted for LoopsBench; see ../NOTICE and LICENSE.harbor.
# Modified: close proxy connections at policy boundaries and filter direct TCP.
set -eu

# ALLOWLIST, GOST_PORT, and GOST_MARK must stay in sync with the literals in
# gost.yaml (file.path, addr, so_mark), which cannot read environment variables.
ALLOWLIST=/opt/egress-sidecar/allowlist.txt
GOST_PORT=12345
GOST_MARK=114514
DNS_MARK=114515
DNS_PORT=1053
NFTABLES_RULESET_NAME=gost_egress

usage() {
  cat <<'EOF'
Usage:
  network-policy show
  network-policy allow-all
  network-policy deny-all
  network-policy allow [TARGET...]
  network-policy rules

TARGET can be an exact domain, IP, or CIDR. With no targets,
allow mode denies all controlled TCP egress.
EOF
}

ensure_file() {
  mkdir -p "$(dirname "$ALLOWLIST")"
  touch "$ALLOWLIST"
}

setup_nftables() {
  nft --file - <<EOF
add table inet $NFTABLES_RULESET_NAME
flush table inet $NFTABLES_RULESET_NAME

table inet $NFTABLES_RULESET_NAME {
  # Run before Docker's own DNS DNAT. The trusted resolver snapshot process
  # alone may contact upstream DNS; task packets reach a static A/AAAA server.
  chain dns {
    type nat hook output priority -110; policy accept;
    meta mark $DNS_MARK return
    udp dport 53 redirect to :$DNS_PORT
    tcp dport 53 redirect to :$DNS_PORT
  }
  chain output {
    type nat hook output priority dstnat; policy accept;

    meta mark $GOST_MARK return
    meta mark $DNS_MARK return
    fib daddr type local return
    meta l4proto tcp redirect to :$GOST_PORT
  }

  chain egress {
    type filter hook output priority filter; policy accept;

    meta mark $GOST_MARK accept
    meta mark $DNS_MARK accept
    # Embedded DNS uses random DNAT ports. Deny the entire resolver address,
    # including sockets opened before the phase change and direct-port probes.
    ip daddr 127.0.0.11 reject
    udp dport 53 reject
    tcp dport 53 reject
    fib daddr type local accept
    reject
  }
}
EOF
}

remove_nftables() {
  nft delete table inet "$NFTABLES_RULESET_NAME" 2>/dev/null || true
}

nftables_enabled() {
  nft list table inet "$NFTABLES_RULESET_NAME" >/dev/null 2>&1
}

show() {
  if nftables_enabled; then
    echo "mode: controlled egress"
  else
    echo "mode: allow-all (transparent proxy disabled)"
  fi
  echo "allowlist: $ALLOWLIST"
  if [ ! -s "$ALLOWLIST" ]; then
    if nftables_enabled; then
      echo "(empty: deny all controlled TCP egress)"
    else
      echo "(empty)"
    fi
    return
  fi
  nl --body-numbering=a "$ALLOWLIST"
}

restart_proxy() {
  if [ -f /tmp/gost.pid ]; then
    kill "$(cat /tmp/gost.pid)" 2>/dev/null || true
    # Wait for the listener to release its port; all forwarded sessions close.
    for attempt in 1 2 3 4 5; do
      kill -0 "$(cat /tmp/gost.pid)" 2>/dev/null || break
      sleep 1
    done
  fi
  /bin/gost -C /opt/egress-sidecar/gost.yaml > /tmp/gost.log 2>&1 &
  echo "$!" > /tmp/gost.pid
  sleep 1
  kill -0 "$(cat /tmp/gost.pid)"
}

restart_dns() {
  rm -f /tmp/dns.ready
  if [ -f /tmp/dns.pid ]; then
    kill "$(cat /tmp/dns.pid)" 2>/dev/null || true
    for attempt in 1 2 3 4 5; do
      kill -0 "$(cat /tmp/dns.pid)" 2>/dev/null || break
      sleep 1
    done
  fi
  /bin/egress-dns snapshot "$ALLOWLIST" /tmp/dns-records.json
  /bin/egress-dns serve /tmp/dns-records.json > /tmp/dns.log 2>&1 &
  echo "$!" > /tmp/dns.pid
  for attempt in 1 2 3 4 5; do
    [ ! -f /tmp/dns.ready ] || break
    sleep 1
  done
  test -f /tmp/dns.ready
  kill -0 "$(cat /tmp/dns.pid)"
}

deny_all() {
  nft --file - <<EOF
add table inet $NFTABLES_RULESET_NAME
flush table inet $NFTABLES_RULESET_NAME
table inet $NFTABLES_RULESET_NAME {
  chain egress {
    type filter hook output priority filter; policy drop;
    # Only the trusted DNS snapshot binary sets this socket mark. Task
    # containers have neither NET_ADMIN nor NET_RAW (also for SO_MARK).
    meta mark $DNS_MARK accept
    ip daddr 127.0.0.11 reject
    udp dport 53 reject
    tcp dport 53 reject
    fib daddr type local accept
    reject
  }
}
EOF
}

ensure_file

cmd="${1:-}"
case "$cmd" in
  show)
    show
    ;;
  allow-all)
    restart_proxy
    remove_nftables
    : > "$ALLOWLIST"
    echo "ok: allow all egress"
    ;;
  deny-all)
    : > "$ALLOWLIST"
    deny_all
    restart_dns
    restart_proxy
    echo "ok: deny external traffic"
    ;;
  allow)
    shift
    deny_all
    : > "$ALLOWLIST"
    for item in "$@"; do
      if [ -n "$item" ]; then
        printf '%s\n' "$item" >> "$ALLOWLIST"
      fi
    done
    restart_dns
    restart_proxy
    setup_nftables
    echo "ok: allowlist applied"
    show
    ;;
  rules)
    if nftables_enabled; then
      nft list table inet "$NFTABLES_RULESET_NAME"
    else
      echo "mode: allow-all"
    fi
    ;;
  *)
    usage
    exit 2
    ;;
esac
